# ==========================================
# Yourosint v2 Environment Configuration
# ==========================================

# Core Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
# Use PostgreSQL with asyncpg in production for pg_trgm & GIN index support:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yourosint
# For testing and lightweight local run, SQLite in-memory / file is supported:
# DATABASE_URL=sqlite+aiosqlite:///yourosint.db

# Privacy & Blind Index (HMAC-SHA256)
BLIND_INDEX_KEY=replace-with-a-strong-32-byte-secret-key-in-production
BLIND_INDEX_KEY_VERSION=v1
OBJECT_HASH_SALT=replace-with-secure-salt

# Telegram API Credentials
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_BOT_TOKEN=

# Parser & Rate Limiting
PARSER_BASE_DELAY=0.8
PARSER_MAX_DELAY=5.0
PARSER_RPM_LIMIT=100

# Threat Intel & OSINT Enrichment API Keys (Optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
WHOIS_API_KEY=
